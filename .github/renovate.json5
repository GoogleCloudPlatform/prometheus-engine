{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  // Process main branch and supported release branches (0.16 and <=0.14 are disabled)
  "baseBranchPatterns": [
    "main",
    "release/0.19",
    "release/0.18",
    "release/0.17",
    "release/0.15"
  ],
  // Schedule updates on weekends to match weekly dependabot interval
  "schedule": [
    "every weekend"
  ],
  // Cooldown / stability period of 7 days before creating PRs
  "minimumReleaseAge": "7 days",
  // Format commit messages to adhere to Conventional Commits and .conform.yaml
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  // Exclude test data and third-party vendored assets
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "ops/gmpctl/data/**",
    "third_party/**"
  ],
  // Run `go mod tidy` and update import paths after Go module upgrades
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  // Surface OSV and GitHub vulnerability alerts across all branches
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "packageRules": [
    // Docker updates
    {
      "description": "Group all Docker image updates into a single PR",
      "matchManagers": ["dockerfile"],
      "groupName": "docker",
      "groupSlug": "docker"
    },
    {
      "description": "Stop upgrading prometheus-engine images as those are handled by manifest command (e.g. make regen)",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": [
        "gke.gcr.io/prometheus-engine/**",
        "gke-release/prometheus-engine/**",
        "gcr.io/gke-release/prometheus-engine/**"
      ],
      "enabled": false
    },
    {
      "description": "Disable Docker image updates on release branches",
      "matchManagers": ["dockerfile"],
      "matchBaseBranches": ["/^release\\/.*$/"],
      "enabled": false
    },
    // Go module updates
    {
      "description": "Skip Prometheus as we need to have it pinned carefully",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/prometheus/prometheus"],
      "enabled": false
    },
    {
      "description": "Group all Go module updates into a single PR",
      "matchManagers": ["gomod"],
      "groupName": "deps",
      "groupSlug": "deps"
    },
    // Release branch restrictions
    {
      "description": "Disable non-root Go modules on release branches",
      "matchManagers": ["gomod"],
      "matchBaseBranches": ["/^release\\/.*$/"],
      "matchFileNames": ["tools/go.mod", "examples/**"],
      "enabled": false
    },
    {
      "description": "Disable non-security Go module updates on release branches (security/vulnerability updates remain enabled)",
      "matchManagers": ["gomod"],
      "matchBaseBranches": ["/^release\\/.*$/"],
      "enabled": false
    }
  ]
}
