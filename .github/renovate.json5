{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  // Process main branch and supported release branches (0.16 and <=0.14 are disabled)
  "baseBranchPatterns": [
    "main",
    "release/0.19",
    "release/0.18",
    "release/0.17",
    "release/0.15"
  ],
  // Schedule updates on weekends to match weekly dependabot interval
  "schedule": [
    "every weekend"
  ],
  // Cooldown / stability period of 7 days before creating PRs
  "minimumReleaseAge": "7 days",
  // Format commit messages to adhere to Conventional Commits and .conform.yaml
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  // Exclude test data and third-party vendored assets
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "ops/gmpctl/data/**",
    "third_party/**"
  ],
  // Run `go mod tidy` and update import paths after Go module upgrades
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  // Surface OSV and GitHub vulnerability alerts across all branches
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "packageRules": [
    // Docker updates
    {
      "description": "Group Docker image updates",
      "matchManagers": ["dockerfile"],
      "groupName": "docker",
      "groupSlug": "docker"
    },
    {
      "description": "Stop upgrading prometheus-engine images as those are handled by manifest command (e.g. make regen)",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": [
        "gke.gcr.io/prometheus-engine/**",
        "gke-release/prometheus-engine/**",
        "gcr.io/gke-release/prometheus-engine/**"
      ],
      "enabled": false
    },
    // Tools Go modules
    {
      "description": "Group tools dependencies",
      "matchManagers": ["gomod"],
      "matchFileNames": ["tools/go.mod"],
      "groupName": "tools",
      "groupSlug": "tools"
    },
    // Root Go modules
    {
      "description": "Skip Prometheus as we need to have it pinned carefully",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/prometheus/prometheus"],
      "enabled": false
    },
    {
      "description": "Group dep updates for k8s as they typically break by assuming all k8s modules are upgraded at the same time",
      "matchManagers": ["gomod"],
      "matchFileNames": ["go.mod"],
      "matchPackageNames": [
        "k8s.io/**",
        "sigs.k8s.io/**"
      ],
      "groupName": "k8s-deps",
      "groupSlug": "k8s-deps"
    },
    {
      "description": "Group root Go module dependencies into one PR as single update already updates co-located deps",
      "matchManagers": ["gomod"],
      "matchFileNames": ["go.mod"],
      "excludePackageNames": [
        "k8s.io/**",
        "sigs.k8s.io/**"
      ],
      "groupName": "deps",
      "groupSlug": "deps"
    },
    // Release branches: only allow security/vulnerability updates for Go modules
    {
      "description": "Disable non-security Go module updates on release branches (security/vulnerability updates remain enabled)",
      "matchManagers": ["gomod"],
      "matchBaseBranches": ["/^release\\/.*$/"],
      "matchPackageNames": ["*"],
      "enabled": false
    }
  ]
}
