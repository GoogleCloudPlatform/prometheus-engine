{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  // Process main branch and all active release branches (unmaintained branches renamed to archive/* are ignored)
  baseBranchPatterns: [
    'main',
    '/^release/.*$/',
  ],
  // Schedule updates on weekends to match weekly dependabot interval
  schedule: [
    'every weekend',
  ],
  // Cooldown / stability period of 7 days before creating PRs
  minimumReleaseAge: '7 days',
  // Format commit messages to adhere to Conventional Commits and .conform.yaml
  semanticCommits: 'enabled',
  semanticCommitType: 'chore',
  semanticCommitScope: 'deps',
  commitMessageTopic: '{{depName}}',
  // Automatically rebase PRs when they become conflicted
  rebaseWhen: 'conflicted',
  // Exclude test data, node modules, vendored assets, and built UI artifacts
  ignorePaths: [
    '**/node_modules/**',
    '**/bower_components/**',
    '**/vendor/**',
    'ops/gmpctl/data/**',
    'third_party/**',
    'pkg/ui/build/**',
  ],
  // Completely ignore Prometheus since it is managed via the GMP fork (including vulnerability alerts)
  ignoreDeps: [
    'github.com/prometheus/prometheus',
    'github.com/GoogleCloudPlatform/prometheus',
  ],
  // Run `go mod tidy` and update import paths after Go module upgrades
  postUpdateOptions: [
    'gomodTidy',
    'gomodUpdateImportPaths',
  ],
  // Surface GitHub and OSV vulnerability alerts across all branches (use lowest fix strategy to minimize churn on release branches)
  vulnerabilityAlerts: {
    enabled: true,
    vulnerabilityFixStrategy: 'lowest',
    packageRules: [
      {
        description: 'Group and automerge non-workflow vulnerability fixes',
        matchManagers: [
          '!github-actions',
        ],
        enabled: true,
        semanticCommitType: 'chore',
        groupName: 'security-fixes',
        groupSlug: 'security-fixes',
        automerge: true,
        automergeType: 'pr',
        addLabels: [
          'automerge',
        ],
      },
      {
        description: 'Keep GitHub Actions workflow vulnerability updates separate and require manual review',
        matchManagers: [
          'github-actions',
        ],
        enabled: true,
        semanticCommitType: 'ci',
        groupName: 'github-actions',
        groupSlug: 'github-actions',
        automerge: false,
      },
    ],
  },
  // Enable OSV.dev vulnerability alerts for cross-branch vulnerability detection
  osvVulnerabilityAlerts: true,
  // Enable GitHub platform automerge (uses gh pr merge --auto)
  platformAutomerge: true,
  // Custom managers to track container images across Helm charts, rendered manifests, and examples
  customManagers: [
    {
      customType: 'regex',
      description: 'Track all container images in charts/values.global.yaml, manifests, and examples',
      managerFilePatterns: [
        '/^charts/values\\.global\\.yaml$/',
        '/^manifests/.*\\.yaml$/',
        '/^cmd/datasource-syncer/datasource-syncer\\.yaml$/',
        '/^examples/inject-gmp-sidecar\\.sh$/',
      ],
      matchStrings: [
        'image:\\s*["\']?(?<depName>[^\\s"\'\\n]+)["\']?\\s*\\n\\s*tag:\\s*["\']?(?<currentValue>[^"\'@\\s\\n]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?["\']?',
        'image:\\s*["\']?(?<depName>[^\\s:"\'\\n]+):(?<currentValue>[^"\'@\\s\\n]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?["\']?',
        '_IMAGE=["\']?(?<depName>[^\\s:"\'\\n]+):(?<currentValue>[^"\'@\\s\\n]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?["\']?',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    // Indirect Go module dependencies: disable routine updates (security vulnerabilities bypass enabled:false via vulnerabilityAlerts)
    {
      description: 'Disable routine updates for indirect Go module dependencies',
      matchManagers: [
        'gomod',
      ],
      matchDepTypes: [
        'indirect',
      ],
      enabled: false,
    },
    // Do not update replace directives in Go modules
    {
      description: 'Do not update replace directives in go.mod',
      matchManagers: [
        'gomod',
      ],
      matchDepTypes: [
        'replace',
      ],
      enabled: false,
    },
    // Exclude code generators from tools/go.mod routine updates to avoid presubmit drift
    {
      description: 'Disable automated updates for tools that generate code/docs to prevent presubmit drift',
      matchManagers: [
        'gomod',
      ],
      matchFileNames: [
        'tools/go.mod',
      ],
      matchPackageNames: [
        'sigs.k8s.io/controller-tools',
        'helm.sh/helm/v3',
        'github.com/efficientgo/tools',
        'github.com/efficientgo/tools/**',
        'github.com/ahmetb/gen-crd-api-reference-docs',
        'github.com/bwplotka/mdox',
        'github.com/mikefarah/yq/v4',
        'k8s.io/code-generator',
      ],
      enabled: false,
    },
    // GitHub Actions workflow updates (require human review; GITHUB_TOKEN lacks workflows permission)
    {
      description: 'Group GitHub Actions workflow updates without automerge',
      matchManagers: [
        'github-actions',
      ],
      groupName: 'github-actions',
      groupSlug: 'github-actions',
      semanticCommitType: 'ci',
      automerge: false,
    },
    // Docker updates
    {
      description: 'Group and automerge Docker image updates',
      matchManagers: [
        'dockerfile',
        'custom.regex',
      ],
      groupName: 'docker',
      groupSlug: 'docker',
      automerge: true,
      automergeType: 'pr',
      addLabels: [
        'automerge',
      ],
    },
    // Short commit/PR topics so single-update commit headers fit .conform.yaml limits (header <= 89, description <= 80).
    // Multi-update groups are unaffected as they use the "{{groupName}}" topic.
    {
      description: 'Use the image basename instead of the docker datasource default topic ("<full depName> Docker tag/digest")',
      // e.g. "chore(deps): update nodejs24 image to b154243" instead of
      // "chore(deps): update us-central1-docker.pkg.dev/serverless-runtimes/google-24-full/runtimes/nodejs24 docker digest to b154243".
      matchDatasources: [
        'docker',
      ],
      commitMessageTopic: '{{{replace "^.*/" "" depName}}} image',
    },
    {
      description: 'Use the last two path segments of Go module paths instead of the full module path',
      // e.g. "fix(deps): update module exporter/metric to v0.55.0" instead of
      // "fix(deps): update module github.com/googlecloudplatform/opentelemetry-operations-go/exporter/metric to v0.55.0".
      // Two segments keep major version suffixes meaningful (e.g. "yq/v4" rather than "v4").
      matchDatasources: [
        'go',
      ],
      commitMessageTopic: 'module {{{replace "^(?:[^/]+/)*?([^/]+/[^/]+)$" "$1" depName}}}',
    },
    {
      description: 'Parse patch, build (-gmp.N), and revision (-gke.N) versions for prometheus-engine images',
      matchManagers: [
        'dockerfile',
        'custom.regex',
      ],
      matchPackageNames: [
        'gke.gcr.io/prometheus-engine/**',
        'gke-release/prometheus-engine/**',
        'gcr.io/gke-release/prometheus-engine/**',
      ],
      versioning: 'regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?:gmp|gke)\\.(?<build>\\d+)(?:-gke\\.(?<revision>\\d+))?$',
    },
    {
      description: 'Allow only patch, build, and revision updates for prometheus-engine images (disable major and minor bumps)',
      matchManagers: [
        'dockerfile',
        'custom.regex',
      ],
      matchPackageNames: [
        'gke.gcr.io/prometheus-engine/**',
        'gke-release/prometheus-engine/**',
        'gcr.io/gke-release/prometheus-engine/**',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
      ],
      enabled: false,
    },
    {
      description: 'Disable minimum release age for 1P Google container images (GCR and Artifact Registry do not expose release timestamps)',
      matchManagers: [
        'dockerfile',
        'custom.regex',
      ],
      matchPackageNames: [
        'gke.gcr.io/**',
        'gcr.io/distroless/**',
        'gcr.io/gke-release/**',
        'google-go.pkg.dev/**',
        '*-docker.pkg.dev/serverless-runtimes/**',
      ],
      minimumReleaseAge: null,
    },
    // Auxiliary Go modules (tools, examples, ops/gmpctl)
    {
      description: 'Group auxiliary Go module dependencies (tools, examples, ops/gmpctl)',
      matchManagers: [
        'gomod',
      ],
      matchFileNames: [
        'tools/go.mod',
        'examples/**',
        'ops/gmpctl/**',
      ],
      groupName: 'auxiliary-modules',
      groupSlug: 'auxiliary-modules',
    },
    // Root Go modules: k8s, OpenTelemetry, and general deps
    {
      description: 'Group dep updates for k8s as they typically break by assuming all k8s modules are upgraded at the same time',
      matchManagers: [
        'gomod',
      ],
      matchFileNames: [
        'go.mod',
      ],
      matchPackageNames: [
        'k8s.io/**',
        'sigs.k8s.io/**',
      ],
      groupName: 'k8s-deps',
      groupSlug: 'k8s-deps',
    },
    {
      description: 'Group OpenTelemetry Go modules to prevent version skew',
      matchManagers: [
        'gomod',
      ],
      matchPackageNames: [
        'go.opentelemetry.io/otel',
        'go.opentelemetry.io/otel/**',
      ],
      groupName: 'opentelemetry',
      groupSlug: 'opentelemetry',
    },
    {
      description: 'Group root Go module dependencies into one PR as single update already updates co-located deps',
      matchManagers: [
        'gomod',
      ],
      matchFileNames: [
        'go.mod',
      ],
      matchPackageNames: [
        '!k8s.io/**',
        '!sigs.k8s.io/**',
        '!go.opentelemetry.io/otel',
        '!go.opentelemetry.io/otel/**',
      ],
      groupName: 'deps',
      groupSlug: 'deps',
    },
    // Automerge SemVer patch updates for root Go modules (excluding k8s, OpenTelemetry, and Prometheus)
    {
      description: 'Automerge patch-level Go module updates on main after CI passes',
      matchManagers: [
        'gomod',
      ],
      matchFileNames: [
        'go.mod',
      ],
      matchUpdateTypes: [
        'patch',
        'digest',
      ],
      matchBaseBranches: [
        'main',
      ],
      matchPackageNames: [
        '!k8s.io/**',
        '!sigs.k8s.io/**',
        '!go.opentelemetry.io/otel',
        '!go.opentelemetry.io/otel/**',
        '!github.com/prometheus/**',
        '!github.com/GoogleCloudPlatform/prometheus',
        '!github.com/GoogleCloudPlatform/prometheus/**',
      ],
      automerge: true,
      automergeType: 'pr',
      addLabels: [
        'automerge',
      ],
    },
    // Release branches policy: disable routine updates for Go modules (security updates remain enabled via vulnerabilityAlerts)
    {
      description: 'Disable routine updates for all Go modules on release branches (security updates remain enabled via vulnerabilityAlerts)',
      matchBaseBranches: [
        '/^release/.*$/',
      ],
      matchManagers: [
        'gomod',
      ],
      enabled: false,
    },
    // Release branches policy: allow only patch and digest updates for Dockerfile and GitHub Actions
    {
      description: 'Disable major and minor updates for Dockerfile and GitHub Actions on release branches (allow patch, digest, and vulnerability fixes)',
      matchBaseBranches: [
        '/^release/.*$/',
      ],
      matchManagers: [
        'github-actions',
        'dockerfile',
        'custom.regex',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
      ],
      enabled: false,
    },
  ],
}
